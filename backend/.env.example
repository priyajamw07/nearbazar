# NearbyBazaar: Ghar Tak — Backend Environment Configuration Template
DEBUG=True
SECRET_KEY=production-hardened-cryptographic-secret-key-nearbybazaar-2026-xyz
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PyMongo)
MONGODB_URI=mongodb://localhost:27017/nearbybazaar
MONGODB_DB_NAME=nearbybazaar

# Redis Cache & Rate Limiting
REDIS_URL=redis://localhost:6379/0

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:4202

# JWT Security
JWT_ACCESS_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7

# Media & Storage
MEDIA_ROOT=media/
MAX_UPLOAD_SIZE_MB=5
